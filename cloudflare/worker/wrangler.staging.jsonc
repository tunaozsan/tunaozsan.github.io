{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bluefin-project-portal-staging",
  "main": "src/staging.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bluefin-project-db-staging",
      "database_id": "f87e0350-e5ef-4173-a728-a0678b882c23",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "bluefin-project-uploads-staging"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "APP_ENV": "test",
    "PORTAL_ENABLED": "false",
    "LEGAL_APPROVED": "false",
    "PUBLIC_SITE_ORIGIN": "https://bluefin-project-portal-staging.bluefintuna-llc.workers.dev",
    "ALLOWED_ORIGINS": "https://bluefin-project-portal-staging.bluefintuna-llc.workers.dev",
    "UPLOAD_SESSION_TTL_SECONDS": "43200",
    "MAX_FILE_SIZE_BYTES": "20971520",
    "MAX_ORDER_SIZE_BYTES": "104857600",
    "MAX_FILES_PER_ORDER": "20",
    "ACCESS_ISSUER": "https://proud-voice-6952.cloudflareaccess.com",
    "ACCESS_AUD": "94290c6bcd9e081ae695bb80122236650e63c67276e14641314feff137164c9a",
    "ADMIN_EMAILS": "ozsan_tuna@yahoo.com.tr",
    "STRIPE_ACCOUNT_ID": "acct_1UVrQ3BxU4PsnoX0",
    "TAX_MODE": "unconfigured",
    "INVOICE_CREATION": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFrEERMLKOiOdyyh",
    "DRIVE_ENABLED": "false",
    "DELIVERY_ENABLED": "false",
    "DELIVERY_POLICY_APPROVED": "false",
    "GOOGLE_CLIENT_ID": "986883109083-q4ur31d3ale1up2irpiprj84ed9gmsps.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": false
  },
  "account_id": "fc9c616595b1d9b6edb82fca91501e47",
  "assets": {
    "directory": ".build/staging-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
